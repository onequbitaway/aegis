# The secrets and the settings of the AEGIS Compose stack.
#
# 1. Copy this file to `.env` in the same directory.
# 2. Give each secret a random value of its own. This command makes one:
#        openssl rand -hex 32
# 3. Do not commit `.env`. Git ignores the file.
#
# A secret with no value stops Compose with an error that names the variable.

# The password of the PostgreSQL role `aegis`. Use only letters and digits, because the
# password is a part of the database URL.
AEGIS_POSTGRES_PASSWORD=

# The token that AEGIS gives to the NATS server. Use only letters and digits.
AEGIS_NATS_TOKEN=

# The API token of the principal `operator@example.com`: 32 characters or more.
# Enter it in the web console, or send it as `Authorization: Bearer <token>`.
AEGIS_TOKEN_OPERATOR=

# The port of the operator API on the loopback address of this host.
AEGIS_API_PORT=8080

# The names of the images that Compose builds and runs. `compose.monitoring-only.yaml`
# reads AEGIS_MONITORING_IMAGE.
AEGIS_IMAGE=aegis:local
AEGIS_POSTGRES_IMAGE=aegis-postgres:local
AEGIS_MONITORING_IMAGE=aegis:monitoring-only
