# The configuration overlay of the profile `local-model`. This file has no secret.
#
# Give this file to Compose after the file `.env`:
#
#   docker compose --env-file .env --env-file local-model.env up --build --detach --wait
#
# The first line starts the model server. The other lines add the [model] section to the
# configuration of AEGIS: each variable sets one key of `aegis.toml`.

COMPOSE_PROFILES=local-model

AEGIS__MODEL__PROVIDERS__LOCAL__KIND=openai_compatible
AEGIS__MODEL__PROVIDERS__LOCAL__BASE_URL=http://ollama:11434/v1
# The model must be in the volume `ollama-models`. Refer to ../README.md.
AEGIS__MODEL__PROVIDERS__LOCAL__CHAT_MODEL=llama3.1:8b
AEGIS__MODEL__ROUTES__DEFAULT=[{ provider = "local" }]
